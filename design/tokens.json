{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "product": "For one", "version": "1.0.0", "date": "2026-11-06", "themes": ["dark", "light"], "default": "dark" },
  "font": {
    "display": { "family": "Anybody", "fallback": ["Arial Narrow", "Impact", "sans-serif"], "axes": { "wdth": [50, 150], "wght": [300, 900] }, "use": "titles, covers, host names" },
    "body":    { "family": "Readex Pro", "fallback": ["system-ui", "Tahoma", "sans-serif"], "axes": { "wght": [200, 700] }, "use": "all reading text, Arabic included" },
    "mono":    { "family": "Martian Mono", "fallback": ["ui-monospace", "Menlo", "monospace"], "axes": { "wdth": [75, 112.5], "wght": [300, 600] }, "use": "timecodes, dates, small labels" }
  },
  "size": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36, "4xl": 48, "5xl": 64 },
  "leading": { "tight": 1.05, "snug": 1.25, "body": 1.55, "read": 1.7, "arabic": 1.9 },
  "tracking": { "display": "-0.01em", "label": "0.08em" },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "gutter": 20, "gutterWide": 32, "measure": "34rem" },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 999 },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)", "easeIn": "cubic-bezier(.4,0,1,1)",
    "duration": { "1": 120, "2": 200, "3": 320, "4": 600 },
    "reducedMotion": "all durations to 0; orbs render static at mid-amplitude"
  },
  "sizes": { "tapMin": 44, "holdPadHeight": 112, "orb": 120, "orbSmall": 40 },
  "color": {
    "dark": {
      "page": "#09080D", "bg": "#110F17", "s1": "#1A1722", "s2": "#24202E", "s3": "#2F2A3B",
      "line": "rgba(255,255,255,.08)", "line2": "rgba(255,255,255,.14)",
      "text": "#F5F1EA", "mute": "#A59FB2", "faint": "#6E6879", "onAccent": "#09080D",
      "karim": "#FF8A4C", "mona": "#FF5C9A", "salma": "#C9BCFF", "learner": "#5FE3B0",
      "recast": "#FFC86B", "warn": "#FF5D5D", "focus": "#8FD3FF", "scrim": "rgba(9,8,13,.72)"
    },
    "light": {
      "page": "#F2EEE6", "bg": "#FBF9F4", "s1": "#FFFFFF", "s2": "#F1EDE5", "s3": "#E6E1D8",
      "line": "rgba(23,20,30,.08)", "line2": "rgba(23,20,30,.16)",
      "text": "#17141E", "mute": "#5A5566", "faint": "#8B869A", "onAccent": "#FFFFFF",
      "karim": "#D9601F", "mona": "#D2306E", "salma": "#6B57C9", "learner": "#178A62",
      "recast": "#8A5A00", "warn": "#C8303A", "focus": "#1F6FD6", "scrim": "rgba(23,20,30,.55)"
    },
    "semantic": {
      "accent": "{learner}", "coverInk": "{text}",
      "rules": [
        "warn is for system failures only (network, payment, mic). It never touches a learner sentence.",
        "recast is a weight and colour shift inside a host caption only. It is never a label, icon, underline or badge.",
        "No colour means 'correct' or 'incorrect'. Green is the learner's voice, not a tick."
      ]
    }
  },
  "contrast": {
    "dark": { "text/bg": 15.6, "mute/bg": 7.1, "faint/bg": 3.4, "learner/bg": 11.9, "karim/bg": 8.6, "mona/bg": 6.1, "salma/bg": 11.1, "recast/bg": 12.3 },
    "light": { "text/bg": 15.4, "mute/bg": 6.9, "faint/bg": 3.6, "learner/bg": 4.9, "karim/bg": 4.6, "mona/bg": 5.0, "salma/bg": 6.2, "recast/bg": 6.8 },
    "note": "faint is for non-text decoration only (dividers, inactive dots). Ratios are approximate WCAG 2 values computed at design time."
  }
}
