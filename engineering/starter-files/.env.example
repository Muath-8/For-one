# For one: local development environment.
# Copy to .env. Everything here is a dev value or empty; no real secret ever goes in this file.
# Keep this file in step with forone.core.settings.Settings; CI fails on a field missing here.

# --- image and mode ---
FORONE_ENV=dev
FORONE_FAKE_VENDORS=1                     # 1 = recorded fixtures for every vendor (free). record = call real vendor once and save. unset = real vendors.
HOME_REGION=local
CALL_WORKER_REGION=local

# --- data stores (docker compose) ---
DATABASE_URL=postgresql+psycopg://forone_app:dev@localhost:5432/forone
DATABASE_URL_READONLY=postgresql+psycopg://forone_readonly:dev@localhost:5432/forone
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=forone-media-dev
S3_BUCKET_VOICE=forone-voice-dev
S3_BUCKET_EXPORTS=forone-exports-dev
KMS_KEY_ID=
MEDIA_SERVICE_KMS_KEY_ID=
DEV_KMS_MASTER_KEY=                       # generated by `make dev`; dev-only stub, never used outside FORONE_ENV=dev

# --- workflow and real-time (docker compose) ---
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
INTERNAL_JWT_SIGNING_KEY=                 # generated by `make dev`

# --- vendors (leave empty; fakes are the default) ---
VENDOR_CONFIG_PATH=packages/adapters/vendors.yaml
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
INWORLD_API_KEY=
SONIOX_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHACE_API_KEY=
OPENAI_API_KEY=

# --- spend guard (dev caps; real caps are set per environment in infra) ---
SPEND_CAP_USD_PER_DAY=20
SPEND_CAP_SAMPLE_USD_PER_DAY=5
SPEND_CAP_PILOT_USD_PER_DAY=5
SESSION_COST_ALERT_USD=1.00
ONBOARDING_STARTS_PER_DAY=20

# --- tracing and errors (empty = Postgres-only tracing, no Sentry) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # EU project only
SENTRY_DSN=

# --- messaging (Mailpit in dev; forone.core.messaging refuses any other host when FORONE_ENV=dev) ---
RESEND_API_KEY=
EMAIL_FROM=show@dev.local
SMTP_DEV_HOST=localhost:1025
VAPID_PUBLIC_KEY=                         # generated by `make dev`
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@dev.local

# --- auth, abuse, payments ---
SESSION_SECRET=                           # generated by `make dev`
COOKIE_DOMAIN=localhost
TURNSTILE_SECRET=1x0000000000000000000000000000000AA   # Cloudflare's documented always-pass test key
RATE_LIMIT_SALT=dev
RESEARCH_PSEUDONYM_SECRET=                # generated by `make dev`
PAYMENTS_PROVIDER=stripe
PAYMENTS_SECRET=                          # Stripe test-mode key from your own test account
PAYMENTS_WEBHOOK_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADMIN_IP_ALLOWLIST=

# --- ops (empty = page to console) ---
BETTERSTACK_TOKEN=
SLACK_OPS_WEBHOOK=

# --- web (apps/web/.env.local mirrors these) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
